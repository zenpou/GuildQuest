[
  {
    "id": "aldo_bow",
    "char": "aldo",
    "title": "アルド、弓を握る",
    "cond": {
      "job": "ranger",
      "minDay": 2
    },
    "lines": [
      {
        "speaker": "アルド",
        "text": "……不思議なんです。弓を持つと、手が迷わない。",
        "background": "guild",
        "cast": [
          {
            "character": "aldo",
            "pose": "thoughtful",
            "position": "left"
          },
          {
            "character": "yuto",
            "pose": "neutral",
            "position": "right"
          }
        ],
        "transition": "fade",
        "sfx": "paper"
      },
      {
        "speaker": "{name}",
        "text": "試してみようと言ったのは僕だけど、弓を引いて、続けると決めたのは君自身だよ。",
        "background": "guild",
        "cast": [
          {
            "character": "aldo",
            "pose": "neutral",
            "position": "left"
          },
          {
            "character": "yuto",
            "pose": "neutral",
            "position": "right"
          }
        ],
        "transition": "cut"
      },
      {
        "speaker": "アルド",
        "text": "剣を捨てるのが怖かった。でも、あなたが『戻ってもいい』と言ってくれたから……ありがとうございます。",
        "background": "guild",
        "cast": [
          {
            "character": "aldo",
            "pose": "happy",
            "position": "left",
            "motion": "nod",
            "motionAt": "ありがとうございます"
          },
          {
            "character": "yuto",
            "pose": "neutral",
            "position": "right"
          }
        ],
        "transition": "cut"
      },
      {
        "speaker": "{name}",
        "text": "(きっかけを渡しただけのつもりが、ずいぶん大きく受け取られてしまった……。)",
        "background": "guild",
        "cast": [
          {
            "character": "aldo",
            "pose": "happy",
            "position": "left"
          },
          {
            "character": "yuto",
            "pose": "thoughtful",
            "position": "right"
          }
        ],
        "transition": "cut"
      }
    ],
    "effects": {
      "loyalty": 10,
      "rep": 1
    }
  },
  {
    "id": "aldo_caution",
    "char": "aldo",
    "title": "慎重の理由",
    "cond": {
      "minExpeditions": 4
    },
    "lines": [
      {
        "speaker": "アルド",
        "text": "僕が慎重なのは、昔、焦って前に出て、仲間に怪我をさせてしまったからなんです。",
        "background": "guild",
        "cast": [
          {
            "character": "aldo",
            "pose": "thoughtful",
            "position": "left"
          },
          {
            "character": "mina",
            "pose": "neutral",
            "position": "right"
          }
        ],
        "transition": "fade",
        "sfx": "paper"
      },
      {
        "speaker": "ミナ",
        "text": "……アルド。あれは、アルド一人のせいじゃないよ。",
        "background": "guild",
        "cast": [
          {
            "character": "mina",
            "pose": "thoughtful",
            "position": "right",
            "motion": "shake",
            "motionAt": "アルド一人のせいじゃない"
          },
          {
            "character": "aldo",
            "pose": "neutral",
            "position": "left"
          }
        ],
        "transition": "cut"
      },
      {
        "speaker": "{name}",
        "text": "話してくれてありがとう。慎重に考えて、引き返す判断も、仲間を守る仕事だよ。",
        "background": "guild",
        "cast": [
          {
            "character": "yuto",
            "pose": "thoughtful",
            "position": "right"
          },
          {
            "character": "aldo",
            "pose": "neutral",
            "position": "left"
          }
        ],
        "transition": "cut"
      }
    ],
    "effects": {
      "loyalty": 6,
      "relation": {
        "with": "mina",
        "delta": 5
      }
    }
  },
  {
    "id": "mina_herb",
    "char": "mina",
    "title": "ミナの薬草知識",
    "cond": {
      "minExpeditions": 2
    },
    "lines": [
