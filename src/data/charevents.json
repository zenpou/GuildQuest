        "background": "guild",
        "cast": [
          {
            "character": "mina",
            "pose": "happy",
            "position": "left"
          },
          {
            "character": "aldo",
            "pose": "neutral",
            "position": "right"
          }
        ],
        "transition": "fade",
        "sfx": "paper"
      },
      {
        "speaker": "アルド",
        "text": "ミナの薬草袋、いつも重いんだよな……",
        "background": "guild",
        "cast": [
          {
            "character": "aldo",
            "pose": "happy",
            "position": "right"
          },
          {
            "character": "mina",
            "pose": "neutral",
            "position": "left"
          }
        ],
        "transition": "cut"
      },
      {
        "speaker": "{name}",
        "text": "薬草の見分け方はミナに教わろう。重い袋は、みんなで分けて持とう。",
        "background": "guild",
        "cast": [
          {
            "character": "yuto",
            "pose": "neutral",
            "position": "right"
          },
          {
            "character": "mina",
            "pose": "neutral",
            "position": "left"
          }
        ],
        "transition": "cut"
      }
    ],
    "effects": {
      "loyalty": 5,
      "relation": {
        "with": "aldo",
        "delta": 3
      }
