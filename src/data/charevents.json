        "transition": "cut"
      },
      {
        "speaker": "{name}",
        "text": "(武勇伝を聞いていただけなのに……でも、本人が少し嬉しそうなら、今日はそれでいい。)",
        "background": "guild",
        "cast": [
          {
            "character": "yuto",
            "pose": "thoughtful",
            "position": "right"
          },
          {
            "character": "mirei",
            "pose": "neutral",
            "position": "left"
          }
        ],
        "transition": "cut"
      }
    ],
    "effects": {
      "loyalty": 4,
      "rep": 1,
      "relation": {
        "with": "lina",
        "delta": -2
      }
    }
  },
  {
