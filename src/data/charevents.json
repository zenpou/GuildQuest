        "transition": "fade",
        "sfx": "paper"
      },
      {
        "speaker": "ブルーノ",
        "text": "ほう。稼いだ金を、自分だけのものにしないとはな。感心だ。",
        "background": "guild",
        "cast": [
          {
            "character": "bruno",
            "pose": "neutral",
            "position": "right"
          },
          {
            "character": "lina",
            "pose": "neutral",
            "position": "left"
          }
        ],
        "transition": "cut"
      },
      {
        "speaker": "リナ",
        "text": "うるさい、おじさん！",
        "background": "guild",
        "cast": [
          {
            "character": "lina",
            "pose": "thoughtful",
            "position": "left",
            "motion": "shake",
            "motionAt": "うるさい"
          },
          {
            "character": "bruno",
            "pose": "neutral",
            "position": "right"
          }
        ],
        "transition": "cut"
      },
      {
        "speaker": "{name}",
        "text": "(報酬を気にする理由にも、数字には出ない事情がある。……本人が話すまで、決めつけないでおこう。)",
        "background": "guild",
        "cast": [
          {
            "character": "yuto",
            "pose": "thoughtful",
            "position": "right"
          },
          {
            "character": "lina",
            "pose": "neutral",
            "position": "left"
          }
        ],
        "transition": "cut"
      }
    ],
    "effects": {
      "loyalty": 8,
      "relation": {
        "with": "bruno",
        "delta": 5
      }
    }
  },
  {
    "id": "bruno_glory",
    "char": "bruno",
