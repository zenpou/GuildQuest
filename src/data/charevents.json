          {
            "character": "lina",
            "pose": "neutral",
            "position": "right"
          }
        ],
        "transition": "fade",
        "sfx": "paper"
      },
      {
        "speaker": "リナ",
        "text": "それ、聞くの五回目〜。",
        "background": "guild",
        "cast": [
          {
            "character": "lina",
            "pose": "thoughtful",
            "position": "right"
