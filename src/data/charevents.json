            "pose": "thoughtful",
            "position": "left"
          },
          {
            "character": "lina",
            "pose": "neutral",
            "position": "right"
          }
        ],
        "transition": "fade",
        "sfx": "paper"
      },
      {
        "speaker": "リナ",
        "text": "ち、違うし！ 景色を堪能してただけだし！",
        "background": "guild",
        "cast": [
          {
            "character": "lina",
            "pose": "thoughtful",
            "position": "right",
            "motion": "recoil",
            "motionAt": "ち、違うし"
          },
          {
            "character": "mirei",
            "pose": "neutral",
            "position": "left"
          }
        ],
        "transition": "cut"
      },
      {
        "speaker": "{name}",
        "text": "(探索は得意なのに、方向音痴か……。人の得意不得意は、数字だけじゃ分からないな。)",
        "background": "guild",
        "cast": [
          {
            "character": "yuto",
            "pose": "thoughtful",
            "position": "left"
          },
          {
            "character": "lina",
            "pose": "neutral",
            "position": "right"
          }
        ],
        "transition": "cut"
      }
    ],
    "effects": {
      "loyalty": 3,
      "revealTrait": "directionless"
    }
  },
  {
    "id": "lina_money",
    "char": "lina",
    "title": "リナの理由",
    "cond": {
      "minDay": 5
    },
    "lines": [
      {
        "speaker": "リナ",
        "text": "……内緒だよ。稼いだお金の半分は、孤児院へ送ってるんだ。",
        "background": "guild",
        "cast": [
          {
            "character": "lina",
            "pose": "thoughtful",
            "position": "left"
          },
          {
            "character": "bruno",
            "pose": "neutral",
            "position": "right"
          }
