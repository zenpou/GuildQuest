  {
    "id": "mina_worry",
    "char": "mina",
    "title": "ミナの心配",
    "cond": {
      "allyInjured": true
    },
    "lines": [
      {
        "speaker": "ミナ",
        "text": "……あの、ギルドマスター。怪我をした人のお見舞いに、行ってもいいですか？",
        "background": "guild",
        "cast": [
          {
            "character": "mina",
            "pose": "thoughtful",
            "position": "left"
          },
          {
            "character": "yuto",
            "pose": "neutral",
            "position": "right"
          }
        ],
        "transition": "fade",
        "sfx": "paper"
      },
      {
        "speaker": "{name}",
        "text": "もちろん。見舞いも大事な仕事だよ。でも、ミナが無理をしない範囲でね。",
        "background": "guild",
        "cast": [
          {
            "character": "mina",
            "pose": "neutral",
            "position": "left"
          },
          {
            "character": "yuto",
            "pose": "neutral",
            "position": "right",
            "motion": "nod",
            "motionAt": "もちろん"
          }
        ],
        "transition": "cut"
      },
      {
        "speaker": "ミナ",
        "text": "(ギルドマスターは、きっと誰も取り残さない人なんだ……)",
        "background": "guild",
        "cast": [
          {
            "character": "mina",
            "pose": "happy",
            "position": "left"
          },
          {
            "character": "yuto",
            "pose": "neutral",
            "position": "right"
          }
        ],
        "transition": "cut"
      }
    ],
    "effects": {
      "loyalty": 8,
      "rep": 1
    }
  },
  {
    "id": "lina_lost",
    "char": "lina",
    "title": "迷子のリナ",
    "cond": {
      "minExpeditions": 3
    },
    "lines": [
      {
        "speaker": "ミレイ",
        "text": "リナさん、また道に迷って、ギルドの前を三周していましたよ。",
